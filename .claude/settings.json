{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/civil-hooks.ts\"",
                        "timeout": 15,
                        "statusMessage": "Civil guard"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/civil-hooks.ts\"",
                        "timeout": 60,
                        "statusMessage": "Civil checks"
                    }
                ]
            }
        ]
    }
}
