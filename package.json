{
    "name": "with-tanstack-router",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:wisp-native": "napi build --release --platform --strip --manifest-path misc/wisp/native/Cargo.toml --output-dir misc/wisp/native",
        "build:wisp-client": "cd misc/wisp/zig-client && zig build",
        "start": "bun run.ts",
        "start:watch": "PORT=1234 bun --watch run.ts",
        "format": "oxfmt -c oxfmt.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "build:configs": "cd misc/config && bun bundle.js",
        "build:configs.visualize": "cd misc/config && bun bundle.js --visualize",
        "lint": "oxlint -c oxlint.config.ts --fix",
        "check": "oxfmt -c oxfmt.config.ts && oxlint -c oxlint.config.ts --fix",
        "db:generate": "drizzle-kit generate --config=misc/database/drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config=misc/database/drizzle.config.ts",
        "db:studio": "drizzle-kit studio --config=misc/database/drizzle.config.ts --host 0.0.0.0",
        "format:check": "oxfmt -c oxfmt.config.ts --check",
        "lint:check": "oxlint -c oxlint.config.ts",
        "audit": "oxlint -c oxlint.config.ts && oxfmt -c oxfmt.config.ts --check && fallow dead-code",
        "audit:advisory": "fallow dupes; fallow health"
    },
