# All variables below without an "Optional" heading are required: the server
# calls validateEnv() (misc/env.ts) on startup and refuses to boot with a list
# of anything missing.

# PostgreSQL
DB_PASSWORD=changeme
# Full connection URL for drizzle-kit (db:migrate, db:studio) and the app
# Docker injects this automatically; for local dev set it manually
DATABASE_URL=postgresql://civil:changeme@localhost:5432/civil

# Redis
REDIS_PASSWORD=changeme
# Like DATABASE_URL, Docker injects this; set it manually for local dev
REDIS_URL=redis://:changeme@localhost:6379

# BetterAuth
# Signs every session token. If this leaks, sessions can be forged for any
# user, including admins — rotate it immediately (this logs everyone out,
# which is the correct outcome). Must be at least 32 characters.
BETTER_AUTH_SECRET=at-least-32-random-characters-here

# Patreon OAuth
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# iBoss filter checker vendor key
IBOSS_SECURITY_KEY=

# Optional
PORT=9876
# Defaults to http://localhost:$PORT
BETTER_AUTH_URL=

# No Chii domain as it works via Docker without a variable needing
# to be set.
