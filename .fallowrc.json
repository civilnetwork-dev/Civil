{
    "$schema": "./node_modules/fallow/schema.json",

    // Everything the repo actually starts from that fallow does not detect on
    // its own. The build scripts and runnable per-vendor examples are listed
    // because nothing imports them: they are invoked as `bun <file>` or named
    // as an input inside bundle.js.
    "entry": [
        "src/entry-client.tsx",
        "src/entry-server.tsx",
        "misc/config/bundle.js",
        "misc/config/baremux/transport.ts",
        "misc/config/scramjet/scramjetInit.ts",
        "misc/config/service/*.ts",
        "misc/browserApiEmulators/extensions/chrome/shim/index.ts",
        "misc/filterProbe/harness.ts",
        "misc/filterProbe/downloadBundles.ts",
        "misc/filters/**/example.ts",
        "tests/**/*.test.{ts,tsx}"
    ],

    // Tracked files that are generated or served as they are. Build output is
    // gitignored, which already keeps fallow out of it.
    "ignorePatterns": [
        "public/**",
        "misc/wisp/native/index.*",
        "src/routeTree.gen.ts"
    ],

    // Shared foundations that nearly every feature imports by design, so their
    // fan-in is the point rather than a coupling smell: the design tokens,
    // Strata recipes, schematic styles and icon registry that DESIGN.md and
    // ICONS.md make the one source for every screen; the typed settings
    // registry and the storage events it rides on; the Hono environment and
    // body/IP helpers every route shares; the verdict shape and category
    // vocabulary every filter checker answers in; the chrome.* event type and
    // bus helpers every emulated API is built from; and the component test
    // mount AGENTS.md requires every DOM test to use. Splitting them would
    // only move the same edges behind barrels.
    "health": {
        "ignore": [
            "src/styles/theme.css.ts",
            "src/styles/material.css.ts",
            "src/styles/schematic.css.ts",
            "src/components/icons/index.tsx",
            "src/lib/settings.ts",
            "src/lib/reactiveStorage.ts",
            "misc/http.ts",
            "misc/filters/verdict.ts",
            "misc/filters/categories.ts",
            "misc/browserApiEmulators/extensions/chrome/shim/event.ts",
            "misc/browserApiEmulators/extensions/chrome/shim/util.ts",
            "tests/helpers/renderSolid.ts"
        ]
    },

    "resolve": {
        "conditions": ["solid", "browser"]
    },

    // The two halves AGENTS.md describes: misc/ shares nothing outside
    // misc/, and the app may use misc/ (the $config/ bundles, mostly). run.ts
    // and tests sit outside both zones, so they may import either.
    "boundaries": {
        "zones": [
            { "name": "app", "patterns": ["src/**"] },
            { "name": "misc", "patterns": ["misc/**"] }
        ],
        "rules": [
            { "from": "app", "allow": ["misc"] },
            { "from": "misc", "allow": [] }
        ]
    },

    "rules": {
        // No rule packs: the conventions AGENTS.md lists are enforced by
        // oxlint, tsc and review.
        "policy-violation": "off"
    },

    "duplicates": {
        "ignore": [
            // Standalone runnable examples (`bun <file>`), one per vendor.
            "misc/filters/**/example.ts"
        ]
    },

    // Real dependencies that no import statement names, so fallow cannot see
    // the edge: the Mercury Workshop transports are served to the browser
    // straight out of node_modules by run.ts, and epoxy-tls ships bundled
    // inside epoxy-transport's dist; @types/stack-trace types the untyped
    // stack-trace import inside @terbiumos/tfs, whose declarations point tsc
    // at its TypeScript source; the rest are build- and test-time tools that
    // get inlined into their output, which is why they stay in
    // devDependencies even though a non-test entry reaches them.
    "ignoreDependencies": [
        "@types/stack-trace",
        "@mercuryworkshop/epoxy-tls",
        "@mercuryworkshop/epoxy-transport",
        "@mercuryworkshop/libcurl-transport",
        "@mercuryworkshop/scramjet-controller",
        "@rollup/plugin-alias",
        "@rollup/plugin-commonjs",
        "@rollup/plugin-node-resolve",
        "@rollup/plugin-terser",
        "fake-indexeddb",
        "rollup-plugin-polyfill-node",
        "rollup-plugin-visualizer"
    ],

    // Modules whose exports are a deliberate public surface rather than a set
    // of call sites: the two design-token stylesheets are the drawing
    // language's shared vocabulary, and the misc/ trees below each expose a
    // shaped API - the database and tunnel barrels, the extension-host
    // harness, the chrome API emulation (whose whole job is to look like
    // chrome.*), and the per-vendor filter countermeasures PRODUCT.md pins as
    // core product surface.
    "ignoreExports": [
        { "file": "src/styles/material.css.ts", "exports": ["*"] },
        { "file": "src/styles/schematic.css.ts", "exports": ["*"] },
        { "file": "misc/database/**", "exports": ["*"] },
        { "file": "misc/extensionHost/**", "exports": ["*"] },
        { "file": "misc/tunnel/**", "exports": ["*"] },
        { "file": "misc/browserApiEmulators/**", "exports": ["*"] },
        { "file": "misc/filters/**", "exports": ["*"] }
    ]
}
